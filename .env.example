# Email delivery
RESEND_API_KEY=
PARTNER_INQUIRY_FROM="Cell Clinics <website@cell-clinics.com>"
PARTNER_INQUIRY_TO="info@cell-education.com"

# First-party form protection: random secret of at least 32 characters.
# Same value on every instance. If empty, RESEND_API_KEY is used server-side.
FORM_GUARD_SECRET=
# Only for a self-hosted trusted reverse proxy that OVERWRITES this header.
# Vercel automatically uses its ingress-provided x-forwarded-for instead.
FORM_TRUSTED_IP_HEADER=

# Optional: set a public canonical base URL
NEXT_PUBLIC_SITE_URL="https://cell-clinics.com"
